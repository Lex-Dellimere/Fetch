// Check helpers shared by the test programs.
import "std/io";

var g_checks: int32 = 0;
var g_fails: int32 = 0;

export fn t_ok(name: string, cond: bool) {
  g_checks = g_checks + 1;
  if (!cond) {
    g_fails = g_fails + 1;
    println("FAIL {name}");
  }
}

export fn t_eq(name: string, got: int64, want: int64) {
  g_checks = g_checks + 1;
  if (got != want) {
    g_fails = g_fails + 1;
    println("FAIL {name}: got {got}, want {want}");
  }
}

export fn t_str(name: string, got: string, want: string) {
  g_checks = g_checks + 1;
  if (got != want) {
    g_fails = g_fails + 1;
    println("FAIL {name}: got \"{got}\", want \"{want}\"");
  }
}

// Prints the summary and returns the exit code.
export fn t_done(name: string) -> int32 {
  println("{name}: {g_checks - g_fails}/{g_checks} checks passed");
  if (g_fails != 0) { return 1; }
  return 0;
}
