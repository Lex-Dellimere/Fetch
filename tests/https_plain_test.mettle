// https to a server that does not speak TLS. This is the error path only; a
// real TLS server is in https_test.
import "http/http";
import "server";
import "tutil";
import "std/arena";
import "std/core";
import "std/conv";

fn page(r: SrvReq*) -> int32 {
  srv_reply(r, 200, "", "plain");
  return 0;
}

fn err_of(r: Result<HttpReply*, string>) -> string {
  match (r) {
    case Ok(x): { return ""; }
    case Err(e): { return e; }
  }
}

fn main() -> int32 {
  srv_start(&page);
  var a: Arena* = arena_init((int64)0);
  var c: HttpClient;
  http_client_init(&c);
  c.timeout_ms = 2000;
  var e: string = err_of(http_client_get(&c, a, "https://127.0.0.1:{srv_port()}/"));
  t_ok("handshake fails: " + e, str_starts_with(e, "TLS handshake failed") == 1);
  t_eq("nothing kept", (int64)http_pool_count(&c.pool), 0);

  // http to the same server still works
  var r: Result<HttpReply*, string> = http_client_get(&c, a, srv_url(a, "/"));
  t_str("http works", err_of(r), "");

  e = err_of(http_client_get(&c, a, "https://127.0.0.1:1/"));
  t_ok("refused: " + e, str_starts_with(e, "connect failed: ") == 1);
  http_client_free(&c);
  return t_done("https_plain");
}
