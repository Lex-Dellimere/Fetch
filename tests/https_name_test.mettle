// A certificate for another name is refused, even when the CA is trusted.
import "fetch/fetch";
import "mtls/mtls";
import "server";
import "tutil";
import "std/arena";
import "std/core";
import "std/conv";

fn page(r: SrvReq*) -> int32 {
  srv_reply(r, 200, "", "secret");
  return 0;
}

fn err_of(r: Result<FetchReply*, string>) -> string {
  match (r) {
    case Ok(x): { return ""; }
    case Err(e): { return e; }
  }
}

fn main() -> int32 {
  var ca: string = import_str "data/tls/ecroot.pem";
  var chain: string = import_str "data/tls/ecserver-chain.pem";
  var key: string = import_str "data/tls/ecserver.key";
  var scfg: MtlsConfig;
  mtls_config_init(&scfg);
  mtls_config_set_cert_pem(&scfg, chain.chars, (int64)chain.length, key.chars, (int64)key.length);
  srv_start_tls(&page, &scfg);

  var roots: MtlsRoots;
  mtls_roots_init(&roots);
  mtls_roots_add_pem(&roots, ca.chars, (int64)ca.length);
  var a: Arena* = arena_init((int64)0);
  var c: FetchClient;
  fetch_client_init(&c);
  c.tls.roots = &roots;

  var e: string = err_of(fetch_client_get(&c, a, "https://127.0.0.1:{srv_port()}/"));
  t_ok("name mismatch: " + e, str_starts_with(e, "certificate refused: ") == 1);
  t_eq("nothing kept", (int64)fetch_pool_count(&c.pool), 0);

  // with the checks off the same server answers
  var d: FetchClient;
  fetch_client_init(&d);
  d.tls.insecure = 1;
  t_str("insecure accepts it", err_of(fetch_client_get(&d, a, "https://127.0.0.1:{srv_port()}/")), "");
  fetch_client_free(&d);
  fetch_client_free(&c);
  mtls_roots_free(&roots);
  return t_done("https_name");
}
