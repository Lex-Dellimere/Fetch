// mbuild.mettle: the project file for http. `mbuild help` lists its commands.
//
// Layout: src/http.mettle is the facade; each feature sits in its own file in src/.
// Tests: tests/<name>_test.mettle, run with `mbuild test` and `mbuild test -r`.
import "mbuild/api";

fn project() {
  mb_package("http", "0.1.0");
  mb_meta("description", "an HTTP client for Mettle on top of std/http: connection pooling, redirects, cookies, gzip and deflate");
  mb_meta("license", "Apache-2.0");
  mb_meta("repository", "https://github.com/Lex-Dellimere/Http");
  mb_import_root("src");
  mb_publish_include("src/, docs/, README.md, LICENSE");
}

fn deps() {
  mb_dep_path("mtls", "../mtls");
  mb_dep_path("press", "../press");
}
